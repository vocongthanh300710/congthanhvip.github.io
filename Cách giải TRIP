<script>
function runDemo(){
  const raw = document.getElementById('inp').value.trim();
  const lines = raw.split(/\n+/).map(l=>l.trim()).filter(Boolean);
  const out = document.getElementById('out');
  try{
    const [N,M,T] = lines[0].split(/\s+/).map(Number);
    const c = [0, ...lines[1].split(/\s+/).map(Number)];
    if (c.length - 1 !== N) throw new Error("Số đỉnh không khớp trọng số");
    const adj = Array.from({length:N+1}, ()=>[]);
    for (let i=0;i<M;i++){
      const [u,v] = lines[2+i].split(/\s+/).map(Number);
      adj[u].push(v);
    }
    const NEG = -1e18;
    let dp = new Array(N+1).fill(NEG);
    dp[1] = c[1];
    for (let t=0;t<T;t++){
      const nd = new Array(N+1).fill(NEG);
      for (let u=1;u<=N;u++){
        if (dp[u] === NEG) continue;
        for (const v of adj[u]){
          nd[v] = Math.max(nd[v], dp[u] + c[v]);
        }
      }
      dp = nd;
    }
    out.textContent = dp[1] === NEG ? "-1" : String(dp[1]);
  }catch(e){
    out.textContent = "Lỗi input: " + e.message;
  }
}
runDemo();
</script>

